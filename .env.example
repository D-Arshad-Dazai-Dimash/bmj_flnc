# ============================================================
# Barnamaj — Environment Variables Template
# Скопируй этот файл в .env (он в .gitignore) и заполни значения.
# ============================================================

# PostgreSQL
POSTGRES_DB=barnamaj_db
POSTGRES_USER=barnamaj_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# pgAdmin
PGADMIN_EMAIL=admin@barnamaj.dev
PGADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# JWT (минимум 64 случайных символа)
# Сгенерировать: openssl rand -base64 64
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET_KEY

# Redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# MinIO (файловое хранилище)
MINIO_ROOT_USER=barnamaj_minio
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MINIO_ROOT_USER=barnamaj_minio
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
