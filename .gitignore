obj/
out/

# .NET
*.user
*.suo
.vs/
*.DotSettings.user
*CLAUDE.md
STACK_LOCK.md
*.pdf
# Logs
logs/
*.log

# Секреты — НИКОГДА не коммитить!
*.env
.env
.env.local
.env.production
backend/Barnamaj.API/appsettings.Production.json

# Docker volumes (при локальной разработке)
postgres_data/
pgadmin_data/

