.vscode/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider / ReSharper
.idea/

# macOS
.DS_Store

# Thumbnails
Thumbs.db

# Node.js / Next.js
node_modules/
.next/
.cache/
*.tsbuildinfo
playwright-report/
test-results/
results.json

# Claude memory (local AI assistant state)
.claude/

# Windows artifacts
nul
