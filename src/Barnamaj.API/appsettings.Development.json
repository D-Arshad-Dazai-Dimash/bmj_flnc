{
  // ============================================================
  // Barnamaj API — Development Configuration
  // Переопределяет значения из appsettings.json
  // ============================================================

  "ConnectionStrings": {
    // В Development: .NET запускается на хосте → подключаемся через localhost
    // В Docker (через docker compose up) используется имя сервиса `db`
    "DefaultConnection": "Host=localhost;Port=5432;Database=barnamaj_db;Username=barnamaj_user;Password=barnamaj_pass_2025;Maximum Pool Size=20;Include Error Detail=true;"
  },

  "Jwt": {
    // В Development используем фиксированный ключ — в продакшне ВСЕГДА из env
    // Сгенерировать случайный ключ: openssl rand -base64 64
    "SecretKey": "dev-barnamaj-secret-key-min-32-chars-change-in-prod-!",
    "Issuer": "barnamaj-api",
    "Audience": "barnamaj-clients",
    "ExpiresInMinutes": 1440
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft": "Information"
      }
    }
  }
}
