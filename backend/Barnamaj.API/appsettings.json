{
  // ============================================================
  // Barnamaj API — Production Configuration
  //
  // ВАЖНО: Никогда не коммитьте реальные пароли!
  // Используйте .env файлы или Docker Secrets в продакшне.
  // ============================================================

  "ConnectionStrings": {
    // Host = имя сервиса `db` в docker-compose.yml
    "DefaultConnection": "Host=db;Port=5432;Database=barnamaj_db;Username=barnamaj_user;Password=REPLACE_VIA_ENV_VAR;Maximum Pool Size=100;Minimum Pool Size=5;Connection Idle Lifetime=300;Connection Pruning Interval=10;Timeout=30;Command Timeout=60;",
    "Redis": "redis:6379,password=REPLACE_VIA_ENV_VAR,abortConnect=false"
  },

  "Jwt": {
    // ВАЖНО: В продакшне этот ключ передавать ТОЛЬКО через переменную окружения:
    //   docker compose environment: Jwt__SecretKey=<ваш_ключ>
    // Минимум 32 символа, желательно 64+ случайных символа
    "SecretKey": "REPLACE_THIS_WITH_64_CHAR_RANDOM_SECRET_KEY_DO_NOT_COMMIT",
    "Issuer": "barnamaj-api",
    "Audience": "barnamaj-clients",
    "AccessTokenExpiresInMinutes": 15,
    "RefreshTokenExpiresInDays": 30
  },

  "AllowedOrigins": [
    "http://localhost:3000",
    "https://barnamaj.dev"
  ],

  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/barnamaj-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "localhost,barnamaj.kz,frontend-fawn-eight-33.vercel.app"
}
