{
  // ============================================================
  // Barnamaj API — Development Configuration
  // Переопределяет значения из appsettings.json
  // ============================================================

  "ConnectionStrings": {
    // В Development: .NET запускается на хосте → подключаемся через localhost
    "DefaultConnection": "Host=localhost;Port=5433;Database=barnamaj_db;Username=barnamaj_user;Password=barnamaj_pass_2025;Maximum Pool Size=20;Include Error Detail=true;",
    "Redis": "localhost:6379,password=barnamaj_redis_dev,abortConnect=false"
  },

  "Jwt": {
    // В Development используем фиксированный ключ — в продакшне ВСЕГДА из env
    "SecretKey": "dev-barnamaj-secret-key-min-32-chars-change-in-prod-!",
    "Issuer": "barnamaj-api",
    "Audience": "barnamaj-clients",
    "AccessTokenExpiresInMinutes": 60,
    "RefreshTokenExpiresInDays": 30
  },

  "Cookie": {
    // В Development: HTTP localhost — Secure=false чтобы cookies работали без HTTPS
    "Secure": false
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft": "Information"
      }
    }
  }
}
