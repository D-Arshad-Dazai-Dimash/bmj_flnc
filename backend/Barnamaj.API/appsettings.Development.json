{
  // ============================================================
  // Barnamaj API — Development Configuration
  // Переопределяет значения из appsettings.json
  // ============================================================

  "ConnectionStrings": {
    // В Development: .NET запускается на хосте → подключаемся через localhost
    "DefaultConnection": "Host=localhost;Port=5433;Database=barnamaj_db;Username=barnamaj_user;Password=barnamaj_pass_2025;Maximum Pool Size=20;Include Error Detail=true;",
    "Redis": "localhost:6379,password=barnamaj_redis_dev,abortConnect=false"
  },

  "Jwt": {
    // В Development используем фиксированный ключ — в продакшне ВСЕГДА из env
    "SecretKey": "dev-barnamaj-secret-key-min-32-chars-change-in-prod-!",
    "Issuer": "barnamaj-api",
    "Audience": "barnamaj-clients",
    "AccessTokenExpiresInMinutes": 60,
    "RefreshTokenExpiresInDays": 30
  },

  "Cookie": {
    // В Development: HTTP localhost — Secure=false чтобы cookies работали без HTTPS
    "Secure": false
  },

  "Kyc": {
    // ── Ключи только для DEV. В PROD — переопределять через переменные окружения:
    //   Kyc__IinHmacKey, Kyc__IinEncryptionKey, Kyc__Otp__HmacKey
    // Сгенерировать: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
    "IinHmacKey":       "a3ljZGV2LWlpbi1obWFjLWtleS1wYWRkaW5nLXp6eno=",
    "IinEncryptionKey": "a3ljZGV2LWlpbi1lbmNyeXB0LWtleS1wYWRkLXp6eno=",
    "DocumentsBucket":  "kyc-documents",
    "Otp": {
      "HmacKey":         "a3ljZGV2LW90cC1obWFjLWtleS1wYWRkaW5nLXp6eno=",
      "CodeLifetimeSec": 300,
      "SendCooldownSec": 60,
      "LockoutMinutes":  15,
      "MaxAttempts":     5
    }
  },

  "Minio": {
    "Endpoint":  "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Secure":    false
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft": "Information"
      }
    }
  }
}
